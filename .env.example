# bkh-kpi environment variables (template).
# Copy to .env.local (dev) or set on the server. NEVER commit real values:
# this repository is public. All variables are server-only — do not add
# the NEXT_PUBLIC_ prefix.

# --- Data source ---------------------------------------------------------
# "his" (default) = real HOSxP database, "mock" = generated demo data.
# Also selects the login provider (his -> HOSxP opduser, mock -> AUTH_MOCK_*).
KPI_DATA_SOURCE=his

# --- HIS (HOSxP MySQL/MariaDB), read-only account with SELECT only --------
HIS_HOST=
HIS_PORT=3306
HIS_USER=
HIS_PASSWORD=
HIS_DATABASE=

# --- Authentication (required to view person lists / export Excel) -------
# Secret used to encrypt the session cookie. At least 32 characters.
# If missing or shorter, login is DISABLED and /api/kpi/screening/persons
# and /export answer 503. Use a different value for each environment;
# changing it logs everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   openssl rand -base64 32
AUTH_SECRET=

# Optional. The session cookie is marked Secure when NODE_ENV=production.
# Set to "true" ONLY if production is served over plain HTTP on the
# intranet (browsers drop Secure cookies on http://). Prefer HTTPS.
AUTH_COOKIE_INSECURE=

# --- Mock login (only used when KPI_DATA_SOURCE=mock) --------------------
# Test account for demo/dev. If username or password is empty, mock login
# always fails. Do not reuse a real password.
AUTH_MOCK_USERNAME=
AUTH_MOCK_PASSWORD=
AUTH_MOCK_DISPLAY_NAME=
