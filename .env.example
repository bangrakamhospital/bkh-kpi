# bkh-kpi environment variables (template).
# Copy to .env.local (dev) or set on the server. NEVER commit real values:
# this repository is public. All variables are server-only — do not add
# the NEXT_PUBLIC_ prefix.

# --- Data source ---------------------------------------------------------
# "his" (default) = real HOSxP database, "mock" = generated demo data.
KPI_DATA_SOURCE=his

# --- HIS (HOSxP MySQL/MariaDB), read-only account with SELECT only --------
HIS_HOST=
HIS_PORT=3306
HIS_USER=
HIS_PASSWORD=
HIS_DATABASE=

# --- Authentication: Auth.js / next-auth v5 (person lists / Excel export) --
# Secret used by Auth.js to encrypt the session cookie (JWT). At least 32
# characters. If missing or shorter, login is DISABLED and
# /api/kpi/screening/persons and /export answer 503. Use a different value
# for each environment; changing it logs everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional. Leave empty: the app runs behind nginx on the intranet and
# trustHost is already enabled in src/auth.ts, so Auth.js uses the
# request Host (nginx must pass Host: $http_host). Set only if the public URL
# differs from what nginx forwards; origin only, NO path (a path would
# change the Auth.js basePath away from /api/auth), e.g. https://10.10.10.159:82
AUTH_URL=
# Optional, no effect (trustHost is hard-coded to true in src/auth.ts).
AUTH_TRUST_HOST=

# Session/CSRF cookies are Secure (__Secure-/__Host- prefixed) when
# NODE_ENV=production. Set to "true" ONLY if production is served over
# plain HTTP on the intranet (browsers drop Secure cookies on http://,
# so login would silently fail). Prefer HTTPS.
AUTH_COOKIE_INSECURE=

# --- Username/password login (OFF by default) ---------------------------
# Sign-in is Provider ID (SSO) only; the login page has no username/password
# form. "true" re-enables the Credentials provider (API only) for emergencies.
AUTH_PASSWORD_LOGIN=

# --- Password login provider (only used when AUTH_PASSWORD_LOGIN=true) ----
# "local" (default) = single account below, "hosxp" = HOSxP opduser table.
AUTH_PROVIDER=local

# --- Local account (AUTH_PROVIDER=local) ---------------------------------
# No default in code: if username or password is empty, login always fails.
# Use a strong password; never commit real values (public repository).
AUTH_USERNAME=
AUTH_PASSWORD=
# Optional display name shown after login (default "ผู้ดูแลระบบ").
AUTH_DISPLAY_NAME=

# --- SSO: PLK Health ID / MOPH Provider ID (OpenID Connect) ---------------
# The "เข้าสู่ระบบด้วย Provider ID" button appears only when all four are set
# and REDIRECT_URI is a valid http(s) URL with path /auth/callback (otherwise
# SSO stays off and a warning is logged). It must match one registered at the
# IdP EXACTLY, and users must open the app on that same origin:
#   dev  http://localhost:3000/auth/callback
#   prod https://10.10.10.159:82/auth/callback
AUTH_PLKHEALTH_ISSUER=
AUTH_PLKHEALTH_ID=
AUTH_PLKHEALTH_SECRET=
AUTH_PLKHEALTH_REDIRECT_URI=
# REQUIRED for SSO sign-in: comma-separated org codes (hospcode) allowed to
# sign in, e.g. 11252. "*" = any account the IdP accepts (nationwide - they
# could then see patient names). EMPTY = every SSO sign-in is DENIED.
AUTH_PLKHEALTH_ALLOWED_ORGS=

# --- User management (approval by an admin) -------------------------------
# After the org allow-list, every SSO user is stored in
# ${KPI_DATA_DIR}/users.json; new users are "pending" until an admin approves
# them at /admin/users. Only approved users can see person lists / export.
# Optional: directory of the local user store (default <app dir>/data).
# Must be writable by the user running the app (pm2) and kept across deploys.
KPI_DATA_DIR=
# Comma-separated Provider ID `sub` values that are ALWAYS approved admins
# (cannot be demoted in the UI). Recommended way to define admins: copy the
# sub from /admin/users after the first login.
AUTH_ADMIN_SUBS=
# Bootstrap only: comma-separated first names (exact match, e.g. ปริยศักดิ์).
# A signing-in user with that first name who passes AUTH_PLKHEALTH_ALLOWED_ORGS
# becomes an approved admin, but only while no approved admin exists yet and
# never when ALLOWED_ORGS is "*". First names are not unique: after the first
# admin has logged in, move their sub to AUTH_ADMIN_SUBS and clear this.
AUTH_BOOTSTRAP_ADMIN_FNAMES=

# HDC AES-256-GCM key (raw text, same as ENCRYPT_KEY of the HDC system).
# Used server-side only to decrypt PERSON.lname in district person lists.
HDC_ENCRYPT_KEY=
